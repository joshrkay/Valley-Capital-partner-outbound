# The principals' web app (PRD E12-S5). Copy to .env.local and fill in. Never commit real values.
# The project's URL and its public anon key. Row-level security does the protecting; the anon key alone can read nothing.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# The same two values, for the browser. The app signs in on the server, so these are optional; set them if a client component needs Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: where the engine (the repository root, with src/ and the rule files) is at runtime. Defaults to the folder above web/.
# ENGINE_ROOT=/absolute/path/to/repo
# NEVER put the service-role key here. The web app acts only as the signed-in principal.
